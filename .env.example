# claude-usage-audit — copy to `.env` and edit. `.env` is gitignored.
# These are paths and settings, not secrets. Every value here can also be passed
# as a CLI flag, which overrides the file.
#
# Most people have ONE account: set CLAUDE_DIR and you're done. Then:
#   python3 -m cua scan --out out/me
#   python3 -m cua compare out/me            # single account: just the report

# --- Primary account -------------------------------------------------------
CLAUDE_DIR=~/.claude
LABEL_1=me
#PROJECT_GLOB_1=                      # optional: keep only projects matching this glob
#PROJECT_GLOB_1_EXCLUDE=             # optional: drop projects matching this glob

# --- Optional second account ----------------------------------------------
# Leave CLAUDE_DIR_2 blank unless you have a separate Claude login to compare.
#CLAUDE_DIR_2=~/.claude-work
#LABEL_2=work
#PROJECT_GLOB_2=
#PROJECT_GLOB_2_EXCLUDE=

# If two accounts SHARE one transcript folder (e.g. one dir's projects/ is a symlink
# to the other's), point both CLAUDE_DIR / CLAUDE_DIR_2 at it and split by project path:
# give the work account an include glob (PROJECT_GLOB_2=*/code/work/*) and the personal
# account the matching exclude (PROJECT_GLOB_1_EXCLUDE=*/code/work/*). `cua scan/waits/sdl`
# then apply the right filter automatically from --label (no --include/--exclude flags
# needed); an explicit flag still overrides the .env globs.

# --- Output ---------------------------------------------------------------
# basename | hash | full — use hash to anonymise project names in shared output.
PROJECT_NAMES=basename

# --- Permission-prompt log (optional; `cua waits`) ------------------------
# Transcripts record only REJECTED prompts, so by default cua INFERS which calls
# prompted from your allow rules. If you log permission prompts yourself with a
# PermissionRequest hook, point cua at that log and it reports the prompts you
# actually approved (approved_prompts), by shape — the exact allow-list triage.
# Tab-separated, one row per prompt: time, kind, mode, project, shape, tool_use_id, ...
# Leave blank if you have no such hook.
#
# A ready-made shape-only logger ships in hooks/ — install it with:
#   python3 hooks/install.py
# then uncomment the matching path below. See hooks/README.md.
#PROMPT_LOG=~/.local/state/cua/prompts.log

# --- SDL / change-management audit (optional; `cua sdl`) -------------------
# Your issue-tracker key(s) for traceability checks, e.g. PROJ or PROJ,OPS.
# Leave blank to skip the ticket-traceability checks entirely.
#TICKET_PREFIX=
# Name + path of the change-management policy the analyst cites. The shipped
# example is generic; point POLICY_DOC at your own policy extract to use it.
#POLICY_NAME=Change-management policy
#POLICY_DOC=.claude/skills/sdl-audit/references/example-sdl-policy.md
